        {
          "name": "Login (Captura Token Automatico)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.environment.set(\"token\", res.token);",
                  "    pm.collectionVariables.set(\"token\", res.token);",
                  "}",
                  "if (res.user) {",
                  "    pm.environment.set(\"userId\", res.user.id);",
                  "    pm.collectionVariables.set(\"userId\", res.user.id);",
                  "    if (res.user.motorista) {",
                  "        pm.environment.set(\"motoristaId\", res.user.motorista.id);",
                  "        pm.collectionVariables.set(\"motoristaId\", res.user.motorista.id);",
                  "    }",
                  "    if (res.user.responsavel) {",
                  "        pm.environment.set(\"responsavelId\", res.user.responsavel.id);",
                  "        pm.collectionVariables.set(\"responsavelId\", res.user.responsavel.id);",
                  "    }",
                  "}",
                  "pm.test(\"Login realizado com sucesso (200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos.motorista@fillmore.com\",\n  \"senha\": \"senhaSegura123\"\n}"
            },
            "url": {
