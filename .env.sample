PORT=4001
NODE_ENV=development
JWT_SECRET=supersecretjwtkey
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=supersecretrefreshjwtkey
JWT_REFRESH_EXPIRES_IN=7d
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<SERVER>/<DATABASE_NAME>?sslmode=require&channel_binding=require
SYNC_DATABASE=false
ERASE_DATABASE_ON_SYNC=false